# ============================================================================ #
#                   TEVANOXMOVIE WEB - ENVIRONMENT VARIABLES                  #
# ============================================================================ #

# API Configuration
VITE_API_URL=https://api.tevanox.com/api/v1

# App Configuration
VITE_APP_NAME=TevanoxMovie
VITE_APP_VERSION=1.0.0
VITE_DOMAIN=tevanox.com

# URLs
VITE_APP_URL=https://tevanox.com
VITE_ADMIN_URL=https://admin.tevanox.com
VITE_AGENT_URL=https://agent.tevanox.com

# Features
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_DOWNLOADS=true
VITE_MAX_DOWNLOADS=50

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_GOOGLE_ANALYTICS=G-XXXXXXXXXX
VITE_SENTRY_DSN=your_sentry_dsn

# Stripe/Payment (optional)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx